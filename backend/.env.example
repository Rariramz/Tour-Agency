# Run `node scripts/setup-local.mjs` from the repository root to generate
# backend/.env with fresh local credentials. Never reuse a real password here.
NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=tour_agency
DB_NAME=tour_agency
DB_PASSWORD=
# The local PostgreSQL container consumes these aliases from this same file.
POSTGRES_USER=tour_agency
POSTGRES_DB=tour_agency
POSTGRES_PASSWORD=
JWT_SECRET=
# Optional when the frontend is hosted on a different origin.
# CORS_ORIGIN=https://example.com,https://www.example.com

# Used only by `npm run seed:demo` on a local development database.
DEMO_ADMIN_EMAIL=admin@tour-agency.local
DEMO_ADMIN_PASSWORD=
